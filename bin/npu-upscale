#!/usr/bin/env python3
"""
npu-upscale: Super-Resolution Upscaler (2x / 4x) on Intel NPU (OpenVINO).
Supports CLI execution and desktop notifications (--notify, e.g. KDE Dolphin service menu).
"""

import argparse
import os
import subprocess
import sys
import time
from pathlib import Path

import numpy as np
import openvino as ov
from PIL import Image

BASE_DIR = Path(os.environ.get("NPU_AI_HOME", Path.home() / ".local" / "share" / "npu-ai"))
MODELS_DIR = Path(os.environ.get("NPU_UPSCALE_MODELS_DIR", BASE_DIR / "models" / "upscaler" / "models"))
CACHE_DIR = Path(os.environ.get("NPU_AI_CACHE_DIR", BASE_DIR / "models" / "cache"))

TILE_SIZE = 256
OVERLAP = 16


def notify(title: str, body: str, icon: str = "zoom-in", urgency: str = "normal") -> None:
    try:
        subprocess.run(
            ["notify-send", "-a", "Intel NPU Upscaler", "-i", icon, "-u", urgency, title, body],
            check=False,
        )
    except Exception:
        pass


def get_model_path(scale: int, mode: str) -> tuple[Path, int]:
    """Return (xml_path, native_model_scale)."""
    if scale == 2:
        xml_2x = MODELS_DIR / "real_esrgan_x2plus_fp32.xml"
        if xml_2x.exists():
            return xml_2x, 2
    if mode == "photo" and (MODELS_DIR / "realesrgan_x4plus_fp16.xml").exists():
        return MODELS_DIR / "realesrgan_x4plus_fp16.xml", 4
    return MODELS_DIR / "real_esrgan_x4plus_anime_6B_fp32.xml", 4


def create_feather_mask(h: int, w: int, overlap: int) -> np.ndarray:
    """Create a 2D feather mask to blend overlapping tiles without visible seams."""
    if overlap <= 0:
        return np.ones((h, w, 1), dtype=np.float32)
    ramp = np.linspace(0.0, 1.0, overlap, dtype=np.float32)
    wx = np.ones(w, dtype=np.float32)
    wy = np.ones(h, dtype=np.float32)
    wx[:overlap] = ramp
    wx[-overlap:] = ramp[::-1]
    wy[:overlap] = ramp
    wy[-overlap:] = ramp[::-1]
    return (wy[:, None] * wx[None, :])[..., None]


def upscale_image(
    img_path: Path,
    compiled_model: ov.CompiledModel,
    model_scale: int,
    target_scale: int,
    out_path: Path | None = None,
    use_notify: bool = False,
    device: str = "NPU",
) -> Path:
    t0 = time.perf_counter()
    img = Image.open(img_path)
    has_alpha = img.mode in ("RGBA", "LA") or (img.mode == "P" and "transparency" in img.info)

    if has_alpha:
        rgba = img.convert("RGBA")
        rgb_img = Image.fromarray(np.array(rgba)[:, :, :3], mode="RGB")
        alpha_img = rgba.split()[3]
    else:
        rgb_img = img.convert("RGB")
        alpha_img = None

    orig_w, orig_h = rgb_img.size
    img_np = np.asarray(rgb_img, dtype=np.uint8)

    step = TILE_SIZE - 2 * OVERLAP
    pad_r = max(0, TILE_SIZE - orig_w) if orig_w < TILE_SIZE else (step - (orig_w - TILE_SIZE) % step) % step
    pad_b = max(0, TILE_SIZE - orig_h) if orig_h < TILE_SIZE else (step - (orig_h - TILE_SIZE) % step) % step

    padded = np.pad(img_np, ((OVERLAP, OVERLAP + pad_b), (OVERLAP, OVERLAP + pad_r), (0, 0)), mode="reflect")
    pad_h, pad_w, _ = padded.shape

    xs = list(range(0, pad_w - TILE_SIZE + 1, step))
    ys = list(range(0, pad_h - TILE_SIZE + 1, step))
    if xs[-1] + TILE_SIZE < pad_w:
        xs.append(pad_w - TILE_SIZE)
    if ys[-1] + TILE_SIZE < pad_h:
        ys.append(pad_h - TILE_SIZE)

    out_tile_size = TILE_SIZE * model_scale
    out_overlap = OVERLAP * model_scale
    feather = create_feather_mask(out_tile_size, out_tile_size, out_overlap)

    out_canvas = np.zeros((pad_h * model_scale, pad_w * model_scale, 3), dtype=np.float32)
    weight_canvas = np.zeros((pad_h * model_scale, pad_w * model_scale, 1), dtype=np.float32)

    infer_req = compiled_model.create_infer_request()
    total_tiles = len(xs) * len(ys)
    done = 0

    for y in ys:
        for x in xs:
            tile = padded[y : y + TILE_SIZE, x : x + TILE_SIZE, :]
            nhwc = np.ascontiguousarray(tile[None, ...], dtype=np.uint8)
            res = infer_req.infer({0: nhwc})
            out_tile = next(iter(res.values()))[0]
            out_tile = np.transpose(out_tile, (1, 2, 0))
            out_tile = np.clip(out_tile, 0.0, 1.0)

            oy, ox = y * model_scale, x * model_scale
            out_canvas[oy : oy + out_tile_size, ox : ox + out_tile_size] += out_tile * feather
            weight_canvas[oy : oy + out_tile_size, ox : ox + out_tile_size] += feather

            done += 1
            if not use_notify and sys.stdout.isatty():
                pct = int(done * 100 / total_tiles)
                print(
                    f"\r\033[1;36m⚡ [{device}]\033[0m {img_path.name}: tile {done}/{total_tiles} ({pct}%)",
                    end="",
                    flush=True,
                )

    if not use_notify and sys.stdout.isatty():
        print()

    merged = out_canvas / np.maximum(weight_canvas, 1e-6)
    crop_y = OVERLAP * model_scale
    crop_x = OVERLAP * model_scale
    final_h = orig_h * model_scale
    final_w = orig_w * model_scale
    merged = merged[crop_y : crop_y + final_h, crop_x : crop_x + final_w]

    out_rgb = Image.fromarray(np.clip(merged * 255.0 + 0.5, 0, 255).astype(np.uint8), mode="RGB")

    if target_scale != model_scale:
        target_w, target_h = orig_w * target_scale, orig_h * target_scale
        out_rgb = out_rgb.resize((target_w, target_h), Image.Resampling.LANCZOS)

    if alpha_img is not None:
        alpha_up = alpha_img.resize(out_rgb.size, Image.Resampling.LANCZOS)
        out_rgb.putalpha(alpha_up)

    if out_path is None:
        out_path = img_path.with_name(f"{img_path.stem}_{target_scale}x.png")

    out_rgb.save(out_path)
    dt = time.perf_counter() - t0
    print(
        f"\033[1;32m✔ Saved:\033[0m {out_path} "
        f"({orig_w}x{orig_h} → {out_rgb.width}x{out_rgb.height} in {dt:.2f}s on {device})"
    )
    return out_path


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="npu-upscale",
        description="Super-Resolution AI Upscaler (Real-ESRGAN) on Intel NPU / Arc GPU",
    )
    parser.add_argument("files", nargs="*", help="Input images to upscale")
    parser.add_argument("-s", "--scale", type=int, choices=[2, 4], default=4, help="Scale factor: 2 or 4 (default: 4)")
    parser.add_argument("-m", "--mode", choices=["fast", "photo"], default="fast", help="Model: fast (6B) or photo (23B)")
    parser.add_argument("-d", "--device", default="NPU", choices=["NPU", "GPU", "CPU"], help="OpenVINO device (default: NPU)")
    parser.add_argument("-o", "--output", type=Path, default=None, help="Output file path (single file only)")
    parser.add_argument("--notify", action="store_true", help="Show desktop notifications (e.g. KDE Dolphin)")
    args = parser.parse_args()

    if not args.files:
        parser.print_help()
        return 1

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    xml_path, model_scale = get_model_path(args.scale, args.mode)
    if not xml_path.exists():
        msg = f"Model not found: {xml_path}"
        print(f"\033[1;31m✘ {msg}\033[0m", file=sys.stderr)
        if args.notify:
            notify("NPU Upscaler Error", msg, icon="dialog-error", urgency="critical")
        return 1

    if args.notify:
        notify(
            f"⚡ Upscaling {args.scale}x on {args.device}",
            f"Processing {len(args.files)} image(s)...",
            icon="zoom-in",
        )

    core = ov.Core()
    core.set_property({"CACHE_DIR": str(CACHE_DIR)})
    model = core.read_model(str(xml_path))
    model.reshape({model.input(0): [1, TILE_SIZE, TILE_SIZE, 3]})

    try:
        compiled = core.compile_model(model, args.device)
        active_device = args.device
    except Exception as e:
        print(f"\033[1;33m⚠ Falling back to GPU ({e})\033[0m", file=sys.stderr)
        compiled = core.compile_model(model, "GPU")
        active_device = "GPU"

    saved_files = []
    for f in args.files:
        p = Path(f).expanduser().resolve()
        if not p.exists():
            print(f"\033[1;31m✘ File not found:\033[0m {p}", file=sys.stderr)
            continue
        try:
            out_p = upscale_image(
                p,
                compiled,
                model_scale=model_scale,
                target_scale=args.scale,
                out_path=args.output if len(args.files) == 1 else None,
                use_notify=args.notify,
                device=active_device,
            )
            saved_files.append(out_p)
        except Exception as e:
            print(f"\033[1;31m✘ Error on {p.name}:\033[0m {e}", file=sys.stderr)
            if args.notify:
                notify("NPU Upscaler Error", f"{p.name}: {e}", icon="dialog-error", urgency="critical")

    if args.notify and saved_files:
        names = ", ".join(p.name for p in saved_files[:3])
        notify(
            f"✅ {args.scale}x Upscaling completed ({active_device})",
            f"Saved: {names}",
            icon="emblem-checked",
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
